{
  "name": "integration-fixture",
  "publisher": "cibyp-test",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.135.0"
  },
  "main": "./extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cibypFixture.documents",
        "title": "Fixture Documents"
      },
      {
        "command": "cibypFixture.terminal",
        "title": "Fixture Terminal"
      },
      {
        "command": "cibypFixture.echo",
        "title": "Fixture Echo"
      }
    ]
  }
}
