{
  "name": "could-i-be-your-partner",
  "version": "1.8.0-alpha.20",
  "description": "全自动AI Agent，帮助完成一切任务",
  "license": "GPL-3.0-or-later",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/build-app-bundle.js && electron .",
    "test": "node scripts/build-app-bundle.js && node tests/run-tests.js",
    "build-app-bundle": "node scripts/build-app-bundle.js",
    "download-voice-models": "node scripts/download-voice-models.js",
    "prepare-build-assets": "node scripts/prepare-build-assets.js",
    "test:geogebra": "electron tests/geogebra-offline-smoke-main.js",
    "build": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-voice-models && node scripts/package.js",
    "build:win:x64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-voice-models && node scripts/package.js --win --x64",
    "build:win:arm64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-voice-models && node scripts/package.js --win --arm64",
    "build:mac:x64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-voice-models && node scripts/package.js --mac --x64",
    "build:mac:arm64": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-voice-models && node scripts/package.js --mac --arm64",
    "build:linux": "npm run build-app-bundle && npm run prepare-build-assets && npm run download-voice-models && node scripts/package.js --linux",
    "build:no-tarot": "node scripts/build-no-tarot.js",
    "build:no-tarot:win": "node scripts/build-no-tarot.js --win",
    "build:no-tarot:mac": "node scripts/build-no-tarot.js --mac",
    "build:no-tarot:linux": "node scripts/build-no-tarot.js --linux",
    "dist": "node scripts/package.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix"
  },
  "author": "B5-Software",
  "build": {
    "appId": "org.b5-software.cibyp",
    "productName": "Could I Be Your Partner",
    "beforePack": "./scripts/eb-before-pack.js",
    "files": [
      "**/*",
      "!claude-code-ref/**/*",
      "!claude-code-ref",
      "!dist/**/*",
      "!dist",
      "!dist-*/**/*",
      "!dist-*",
      "!out/**/*",
      "!out",
      "!tests/**/*",
      "!tests",
      "!*.md",
      "!dist-output.txt",
      "!assets/geogebra-src/**/*",
      "!assets/geogebra-src",
      "!assets/sandbox/**/*"
    ],
    "asarUnpack": [
      "assets/ocr/**/*",
      "assets/voice-models/**/*",
      "assets/ui-fonts/**/*",
      "assets/geogebra-app/**/*",
      "src/main/voice-worker.js",
      "src/main/voice-kws-encoder.js",
      "node_modules/monaco-editor/min/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@nut-tree-fork/**/*",
      "node_modules/@xterm/xterm/css/**/*",
      "node_modules/@xterm/xterm/lib/**/*",
      "node_modules/@xterm/addon-fit/lib/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-darwin-arm64/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*",
      "node_modules/pinyin-pro/**/*",
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/@ffprobe-installer/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/aria2/${os}-${arch}",
        "to": "aria2",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icons/icons/icon.ico",
      "extraResources": [
        {
          "from": "assets/sandbox/win",
          "to": "sandbox"
        }
      ],
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/icons/icons/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "需要访问本地网络以连接 Remote 模式下的远端设备和 WebUI 控制服务。",
        "NSMicrophoneUsageDescription": "需要访问麦克风以提供语音输入与后台唤醒功能。音频仅在本机处理，不会上传或存储。",
        "NSBonjourServices": [
          "_http._tcp",
          "_airplay._tcp",
          "_services._dns-sd._udp",
          "_cibyp._tcp"
        ],
        "NSAppleEventsUsageDescription": "需要发送 AppleEvent 以使用系统无障碍 API 获取 UI 树和自动化操作。",
        "NSAppleMusicUsageDescription": "应用需要控制媒体播放以执行用户指令。"
      }
    },
    "linux": {
      "icon": "assets/icons/icons"
    }
  },
  "overrides": {
    "semver": "^7.6.3",
    "tmp": "^0.2.4",
    "tar": "^7.5.4",
    "lodash": "^4.17.23",
    "ws": "^8.18.0",
    "form-data": "^4.0.4",
    "qs": "^6.14.0",
    "path-to-regexp": "^8.3.0",
    "picomatch": "^4.0.4",
    "ip-address": "^10.1.0",
    "brace-expansion": "^5.0.9",
    "dompurify": "^3.4.13",
    "@xmldom/xmldom": "^0.8.13",
    "linkify-it": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@serialport/bindings-cpp": "^13.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "node-gyp": "^12.2.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@eslint/js": "^10.0.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "chardet": "^2.2.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "eslint": "^10.7.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-ws": "^5.0.2",
    "fast-xml-parser": "^5.10.1",
    "iconv-lite": "^0.7.3",
    "imap-simple": "^1.6.3",
    "jsqr": "^1.4.0",
    "js-yaml": "^4.3.0",
    "katex": "^0.17.0",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.1",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.3",
    "officeparser": "^6.1.1",
    "otpauth": "^9.5.1",
    "pdf-parse": "^2.4.5",
    "pinyin-pro": "^3.28.2",
    "pizzip": "^3.2.0",
    "playwright": "^1.61.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "sherpa-onnx-node": "^1.13.4",
    "tesseract.js": "^6.0.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "@serialport/bindings-cpp@13.0.1": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "@ffmpeg-installer/darwin-arm64@4.1.5": true,
    "@ffmpeg-installer/darwin-x64@4.1.0": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "@ffprobe-installer/darwin-x64@5.1.0": true,
    "fsevents@2.3.2": true,
    "tesseract.js@6.0.1": true,
    "electron-winstaller@5.4.0": true
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@ffprobe-installer/win32-x64": "^5.1.0"
  }
}
